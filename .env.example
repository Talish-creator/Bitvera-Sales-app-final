# =============================================================================
# BITVERA SALES ENTERPRISE — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env.local for local development. Never commit .env secrets.

# AI Studio & Core Configuration
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
PORT=3000

# Backend Authentication & Session Security
JWT_SECRET="YOUR_STRONG_RANDOM_JWT_SECRET_HERE"
SESSION_SECRET="YOUR_SESSION_SECRET_HERE"

# ERPNext Master Server Configuration (Control Plane & Proxy only - NEVER EXPOSE TO CLIENT)
ERPNEXT_URL="https://erp.bitvera.sa"
ERPNEXT_API_KEY="YOUR_ERPNEXT_API_KEY"
ERPNEXT_API_SECRET="YOUR_ERPNEXT_API_SECRET"

# Control Plane & Health Authentication
CONTROL_PLANE_SECRET="YOUR_CONTROL_PLANE_SECRET"

# ZATCA Electronic Invoicing
ZATCA_ENVIRONMENT="sandbox" # "sandbox" or "production"
ZATCA_SELLER_NAME="Bitvera ERP IT Solution"
ZATCA_VAT_NUMBER="310123456700003"
